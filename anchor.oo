// # Root Verification Anchor for oohost
//
// Logline: Top-level integration test orchestrating core, render, and ipc subsystem anchors.
//
// Setup: Demands zero ambient authority, verifying host parsing, record formatting, and CLI flags.
//
// Beats:
//   1. Verify core IP classification and DNS host resolution.
//   2. Verify render subsystem BIND syntax and JSON serialization.
//   3. Verify ipc subsystem argument parsing and JSON decoding.
//   4. Export top-level system verification routine for test harness.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all() -> Bool {
    if verify_core() == false {
        return false;
    }
    if verify_render() == false {
        return false;
    }
    if verify_ipc() == false {
        return false;
    }
    return true;
}
