// # Core Subsystem Verification Anchor
//
// Logline: Automated self-tests for IP classification, reverse PTR encoding, and resolution logic.
//
// Setup: Exercises IPv4/IPv6 classification, pointer calculation, and host resolution.
//
// Beats:
//   1. Verify IPv4 and IPv6 network address detection predicates.
//   2. Verify in-addr.arpa and ip6.arpa reverse pointer string generation.
//   3. Verify resolv.conf nameserver parser and hosts file overrides.
//   4. Verify forward and reverse DNS record resolution pipelines.

import "core/host_types.oo";
import "core/host_reverse.oo";
import "core/host_resolver.oo";

pub fn verify_core() -> Bool {
    // Test 1: IPv4 and IPv6 classification
    if is_ipv4("192.168.1.1") == false || is_ipv4("example.com") {
        return false;
    }
    if is_ipv6("2001:db8::1") == false || is_ipv6("127.0.0.1") {
        return false;
    }
    if is_ip_address("8.8.8.8") == false || is_ip_address("google.com") {
        return false;
    }

    // Test 2: Reverse pointer generation
    let ptr4: String = format_ipv4_reverse("93.184.215.14");
    if ptr4 != "14.215.184.93.in-addr.arpa" {
        return false;
    }

    let ptr6: String = format_ipv6_reverse("2001:db8::1");
    if str_ends_with(ptr6, ".ip6.arpa") == false {
        return false;
    }

    // Test 3: Resolv conf parsing
    let mock_conf: String = "# Generated by NetworkManager\nnameserver 127.0.0.53\nnameserver 1.1.1.1\n";
    let ns_list: List[String] = parse_resolv_conf(mock_conf);
    if list_len(ns_list) != 2 || list_get(ns_list, 0) != "127.0.0.53" {
        return false;
    }

    // Test 4: Hosts lookup
    let mock_hosts: String = "127.0.0.1 localhost\n192.168.1.100 myserver\n";
    let found_ip: String = lookup_hosts_file(mock_hosts, "myserver");
    if found_ip != "192.168.1.100" {
        return false;
    }
    let found_host: String = reverse_lookup_hosts_file(mock_hosts, "192.168.1.100");
    if found_host != "myserver" {
        return false;
    }

    // Test 5: HostOpts and HostRecord models
    let mut opts: HostOpts = default_host_opts();
    opts.target = "example.com";
    opts.rtype = "A";
    let rec: HostRecord = make_host_record("example.com", 300, "IN", "A", "93.184.215.14");
    if rec.ttl != 300 || rec.data != "93.184.215.14" {
        return false;
    }

    return true;
}
