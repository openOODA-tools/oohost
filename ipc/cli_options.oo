// # Command Line Interface Options Parser for oohost
//
// Logline: Decodes POSIX flags, query types, and server parameters into structured options.
//
// Setup: Pure string argument processor avoiding nested struct mutation to maintain compiler safety.
//
// Beats:
//   1. Parse target hostname or IP address and optional custom nameserver.
//   2. Parse record type filters (-t a, -t aaaa, -t mx, -t txt, -t soa, -a).
//   3. Support terse short mode (-s, --short) and verbose diagnostics (-v, --verbose).
//   4. Export default and parsed configuration structs.

import "core/host_reverse.oo";

pub type CliParsedOptions = struct {
    target: String,
    server: String,
    rtype: String,
    port: Int,
    short_mode: Bool,
    verbose: Bool,
    all_records: Bool,
    is_reverse: Bool,
    json: Bool,
    color: Bool,
    demo: Bool,
    test: Bool,
    help: Bool,
    version: Bool,
    mcp: Bool
};

pub fn default_cli_options() -> CliParsedOptions {
    return CliParsedOptions {
        target: "",
        server: "",
        rtype: "A",
        port: 53,
        short_mode: false,
        verbose: false,
        all_records: false,
        is_reverse: false,
        json: false,
        color: true,
        demo: false,
        test: false,
        help: false,
        version: false,
        mcp: false
    };
}

pub fn parse_cli_options(args: List[String]) -> CliParsedOptions {
    let mut opts: CliParsedOptions = default_cli_options();
    let num_args: Int = list_len(args);
    let mut i: Int = 0;
    let mut pos_count: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);

        if arg == "-h" || arg == "--help" {
            opts.help = true;
        } else if arg == "--version" {
            opts.version = true;
        } else if arg == "--mcp" {
            opts.mcp = true;
        } else if arg == "-D" || arg == "--demo" {
            opts.demo = true;
        } else if arg == "--test" {
            opts.test = true;
        } else if arg == "-j" || arg == "--json" {
            opts.json = true;
        } else if arg == "-v" || arg == "--verbose" {
            opts.verbose = true;
        } else if arg == "-s" || arg == "--short" {
            opts.short_mode = true;
        } else if arg == "-a" || arg == "-C" || arg == "--all" {
            opts.all_records = true;
            opts.rtype = "ANY";
        } else if arg == "-r" || arg == "--reverse" {
            opts.is_reverse = true;
        } else if arg == "--no-color" {
            opts.color = false;
        } else if (arg == "-t" || arg == "--type") && i + 1 < num_args {
            i = i + 1;
            let raw_type: String = list_get(args, i);
            if raw_type == "any" || raw_type == "ANY" {
                opts.all_records = true;
                opts.rtype = "ANY";
            } else if raw_type == "a" || raw_type == "A" {
                opts.rtype = "A";
            } else if raw_type == "aaaa" || raw_type == "AAAA" {
                opts.rtype = "AAAA";
            } else if raw_type == "mx" || raw_type == "MX" {
                opts.rtype = "MX";
            } else if raw_type == "txt" || raw_type == "TXT" {
                opts.rtype = "TXT";
            } else if raw_type == "cname" || raw_type == "CNAME" {
                opts.rtype = "CNAME";
            } else if raw_type == "ns" || raw_type == "NS" {
                opts.rtype = "NS";
            } else if raw_type == "soa" || raw_type == "SOA" {
                opts.rtype = "SOA";
            } else if raw_type == "ptr" || raw_type == "PTR" {
                opts.rtype = "PTR";
                opts.is_reverse = true;
            } else {
                opts.rtype = raw_type;
            }
        } else if arg == "--server" && i + 1 < num_args {
            i = i + 1;
            opts.server = list_get(args, i);
        } else if !str_starts_with(arg, "-") {
            if pos_count == 0 {
                opts.target = arg;
                if is_ip_address(arg) {
                    opts.is_reverse = true;
                }
                pos_count = 1;
            } else if pos_count == 1 {
                opts.server = arg;
                pos_count = 2;
            }
        }
        i = i + 1;
    }

    return opts;
}
